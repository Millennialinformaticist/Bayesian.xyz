# Optional local overrides (never commit real tokens)
#
# Browser /info override (preferred for QN):
#   localStorage.setItem("hl_qn_info_url", "https://YOUR.quiknode.pro/<TOKEN>/hyperliquid/hl/info")
#   Clear with: localStorage.removeItem("hl_qn_info_url")
# The screener reads hl_qn_info_url via getHlInfoUrl(); otherwise uses https://api.hyperliquid.xyz/info.
# Never hardcode tokens in source.
#
# Optional server-side hint (docs / automation only — the static HTML does not read .env):
# HL_QN_INFO_URL=https://YOUR.quiknode.pro/<TOKEN>/hyperliquid/hl/info
